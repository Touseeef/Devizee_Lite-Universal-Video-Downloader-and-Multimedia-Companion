{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devizee Lite",
  "version": "0.3.0",
  "identifier": "com.devizee.downloadmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Devizee Lite - Universal Video Downloader",
        "width": 1180,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: asset: http://asset.localhost; media-src 'self' https: data: blob: asset: http://asset.localhost; connect-src 'self' https: ipc: http://ipc.localhost asset: http://asset.localhost; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOWNLOAD/**",
          "$VIDEO/**",
          "$AUDIO/**",
          "$PICTURE/**",
          "$APPDATA/**",
          "$LOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/yt-dlp",
      "bin/ffmpeg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}